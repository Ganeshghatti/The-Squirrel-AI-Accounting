{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "AI Accounting API",
    "description": "Users routes require an **admin** API key. Company routes accept any valid user API key.\n\nSet `baseUrl`, `apiKey`, `companyId`, `mailboxId` (from connect-email response `_id`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "apiKey", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "mailboxId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Validate API key",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/validate",
            "description": "Returns `{ \"ok\": true }` if `X-API-Key` is valid. Used by the desktop app on login."
          }
        }
      ]
    },
    {
      "name": "Users (admin only)",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"name\": \"Jane User\",\n  \"phone\": \"+15550001111\",\n  \"role\": \"user\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Q. User\",\n  \"phone\": \"+15550002222\",\n  \"role\": \"user\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Soft-delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "List companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/companies"
          }
        },
        {
          "name": "Get company by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/companies/{{companyId}}"
          }
        },
        {
          "name": "Create company",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Ltd\",\n  \"desc\": \"Consulting\"\n}"
            },
            "url": "{{baseUrl}}/api/companies"
          }
        },
        {
          "name": "Update company",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Limited\",\n  \"desc\": \"Updated tagline\"\n}"
            },
            "url": "{{baseUrl}}/api/companies/{{companyId}}"
          }
        },
        {
          "name": "Connect email (IMAP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Billing Gmail\",\n  \"emailAddress\": \"billing@acme.com\",\n  \"imapHost\": \"imap.gmail.com\",\n  \"imapPort\": 993,\n  \"tls\": true,\n  \"username\": \"billing@acme.com\",\n  \"password\": \"app-specific-password-here\"\n}"
            },
            "url": "{{baseUrl}}/api/companies/{{companyId}}/mailboxes"
          }
        },
        {
          "name": "Disconnect email",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/companies/{{companyId}}/mailboxes/{{mailboxId}}"
          }
        },
        {
          "name": "Soft-delete company",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/companies/{{companyId}}"
          }
        }
      ]
    }
  ]
}
